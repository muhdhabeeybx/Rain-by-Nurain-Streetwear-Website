# Copy to .env.local and fill in. Never commit real values.

# Public URL of the site, no trailing slash. Used for payment callbacks and SEO.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Bypasses row level security — keep secret.
SUPABASE_SECRET_KEY=sb_secret_...

# Paystack → Settings → API Keys & Webhooks (use sk_test_ until launch)
PAYSTACK_SECRET_KEY=sk_test_...

# Optional: order emails via Resend (resend.com). Needs a verified sending domain.
# RESEND_API_KEY=re_...
# EMAIL_FROM="Rain by Nurain <orders@rainbynurain.com>"
